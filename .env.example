# ═══════════════════════════════════════════════════════════════
#  WhatsApp Marketing Dashboard – Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── WhatsApp Cloud API ───────────────────────────────────────
# Get these from https://developers.facebook.com → Your App → WhatsApp
WHATSAPP_TOKEN=your_permanent_or_temporary_access_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here

# ─── Webhook ─────────────────────────────────────────────────
# Choose any value – enter the same string in the Meta webhook config
VERIFY_TOKEN=myverifytoken_changeme

# ─── Dashboard Auth ──────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password

# ─── Session Security ────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_secret_key_at_least_32_chars

# ═══════════════════════════════════════════════════════════════
#  Legacy Node.js / Ads Agent variables (keep if using that app)
# ═══════════════════════════════════════════════════════════════

# Server Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-secret-minimum-32-chars
JWT_EXPIRES_IN=7d

# Database
POSTGRES_DB=hero_ads
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@postgres:5432/hero_ads
DATABASE_URL_LOCAL=postgresql://postgres:password@localhost:5432/hero_ads

# Redis
REDIS_URL=redis://redis:6379
REDIS_URL_LOCAL=redis://localhost:6379

# Meta Ads API
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-long-lived-access-token
META_AD_ACCOUNT_ID=act_123456789

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CLIENT_ID=your-oauth2-client-id
GOOGLE_ADS_CLIENT_SECRET=your-oauth2-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADS_CUSTOMER_ID=123-456-7890

# AI Services
OPENAI_API_KEY=sk-your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Encryption (must be 32 bytes for AES-256)
ENCRYPTION_KEY=change-this-to-32-byte-key-exactly

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Notification (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
NOTIFICATION_EMAIL=admin@herojaipur.com
